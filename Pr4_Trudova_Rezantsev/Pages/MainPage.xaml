<Page x:Class="Pr4_Trudova_Rezantsev.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pr4_Trudova_Rezantsev.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="1">
            <Image Source="/Images/Formula1.jpg" Margin="10"/>
            <Button Content="Формула 1" Margin="10" Height="30" Click="Button_Formula1"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="1">
            <Image Source="/Images/Formula2.jpg" Margin="10"/>
            <Button Content="Формула 2" Margin="10" Height="30" Click="Button_Formula2"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="2">
            <Image Source="/Images/Formula3.jpg" Margin="10" />
            <Button Content="Формула 3" Margin="10" Height="30" Click="Button_Formula3"/>
        </StackPanel>
    </Grid>
</Page>
